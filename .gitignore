# --- Dependencies ---
node_modules/
npm-debug.log
yarn-error.log

# --- System files (Mac/Windows/Linux) ---
.DS_Store       # macOS system file
Thumbs.db       # Windows thumbnail cache
ehthumbs.db     # Windows thumbnail cache
Desktop.ini     # Windows system file

# --- IDEs and Editors ---
.idea/          # JetBrains IDEs (IntelliJ, WebStorm, etc.)
.vscode/        # VS Code settings folder
*.swp           # Vim swap files
*.swo           # Vim swap files
*.sublime-workspace
*.sublime-project

# --- Environment variables (very important!) ---
.env
.env.local
.env.*.local

# --- Docker ---
docker-compose.override.yml

# --- Build and distribution (in case of building in root) ---
dist/
build/
coverage/

# --- Other junk ---
tmp/
temp/
